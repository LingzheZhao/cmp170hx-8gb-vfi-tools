diff --git a/host/passive_snapshot.py b/host/passive_snapshot.py
new file mode 100644
index 0000000..821aba9
--- /dev/null
+++ b/host/passive_snapshot.py
@@ -0,0 +1,96 @@
+"""Read the diagnostic registers without writes, stopping at the first bad read."""
+from __future__ import annotations
+
+import argparse
+import json
+import mmap
+import os
+import re
+import struct
+from pathlib import Path
+from typing import Callable
+
+REGISTERS = (
+    ("FUSECTRL", 0x820000),
+    ("GFW", 0x118234),
+    ("DSOV", 0x820084),
+    ("CRC", 0x820070),
+    ("PLM", 0x8200FC),
+)
+
+
+def observe(read32: Callable[[int], int]) -> dict:
+    result = {"state": "unknown", "reason": None,
+              "registers": {name: None for name, _ in REGISTERS}}
+    values = result["registers"]
+    for name, address in REGISTERS:
+        try:
+            value = read32(address)
+        except OSError as exc:
+            result["reason"] = f"{name}: {exc}"
+            return result
+        values[name] = value
+        if value & 0xFFFF0000 == 0xBADF0000:
+            result.update(state="poisoned", reason=f"{name}: BADF sentinel")
+            return result
+        if value == 0xFFFFFFFF and name != "PLM":
+            result["reason"] = f"{name}: all-ones response"
+            return result
+        if name == "GFW" and value & 0xFF == 1:
+            result.update(state="booting", reason="GFW low byte is 0x01")
+            return result
+        if name == "DSOV" and value not in (0, 1):
+            result["reason"] = "DSOV: unexpected value"
+            return result
+    if values["DSOV"] == 1 and values["CRC"] == 0x55 and values["PLM"] == 0xFFFFFFFF:
+        result["state"] = "healthy_locked"
+    elif values["DSOV"] == 0 and values["CRC"] == 0x55 and values["PLM"] == 0xFFFFFFFF:
+        result.update(state="candidate", reason="Passive signature only; active validation not performed")
+    else:
+        result.update(state="partial_or_corrupt", reason="Diagnostic signature is not healthy")
+    return result
+
+
+def snapshot(bdf: str) -> dict:
+    if not re.fullmatch(r"[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-7]", bdf):
+        raise ValueError("Expected a PCI BDF such as 0000:05:00.0")
+    device = Path("/sys/bus/pci/devices") / bdf
+    if (device / "driver").resolve(strict=True).name != "pci-stub":
+        raise RuntimeError("GPU must be bound to pci-stub")
+    with (device / "config").open("rb") as stream:
+        config = stream.read(20)
+    if len(config) != 20 or struct.unpack_from("<I", config)[0] != 0x20C210DE:
+        raise RuntimeError("CMP 170HX PCI identity unavailable or changed")
+    if not struct.unpack_from("<H", config, 4)[0] & 2:
+        raise RuntimeError("PCI memory decode is off; observer will not enable it")
+    with (device / "resource").open() as stream:
+        start, end, _ = (int(x, 16) for x in stream.readline().split())
+    if not start or end - start + 1 < 16 << 20:
+        raise RuntimeError("BAR0 allocation is absent or too small")
+    if struct.unpack_from("<I", config, 16)[0] & 0xFFFFFFF0 != start & 0xFFFFFFF0:
+        raise RuntimeError("BAR0 is not restored; observer will not restore it")
+    fd = os.open(device / "resource0", os.O_RDONLY | os.O_SYNC)
+    try:
+        with mmap.mmap(fd, 16 << 20, flags=mmap.MAP_SHARED, prot=mmap.PROT_READ) as bar:
+            result = observe(lambda offset: struct.unpack_from("<I", bar, offset)[0])
+    finally:
+        os.close(fd)
+    result["bdf"] = bdf
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--bdf", default=os.environ.get("VFI_BDF"), required=not os.environ.get("VFI_BDF"),
+                        help="the card's PCI address (lspci -Dn -d 10de:20c2), or set VFI_BDF")
+    args = parser.parse_args()
+    try:
+        result = snapshot(args.bdf)
+    except (OSError, ValueError, RuntimeError) as exc:
+        result = {"state": "unknown", "reason": str(exc), "bdf": args.bdf}
+    print(json.dumps(result, indent=2))
+    return 0 if result["state"] in ("healthy_locked", "candidate") else 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/host/test_passive_snapshot.py b/host/test_passive_snapshot.py
new file mode 100644
index 0000000..b461785
--- /dev/null
+++ b/host/test_passive_snapshot.py
@@ -0,0 +1,51 @@
+import unittest
+
+from passive_snapshot import REGISTERS, observe
+
+
+class PassiveSnapshotTest(unittest.TestCase):
+    def run_reads(self, data):
+        calls = []
+
+        def read(address):
+            calls.append(address)
+            value = data[len(calls) - 1]
+            if isinstance(value, Exception):
+                raise value
+            return value
+
+        return observe(read), calls
+
+    def test_baseline_accepts_open_privilege_mask(self):
+        result, calls = self.run_reads([0xE0040000, 0x3FF, 1, 0x55, 0xFFFFFFFF])
+        self.assertEqual(result["state"], "healthy_locked")
+        self.assertEqual(calls, [offset for _, offset in REGISTERS])
+
+    def test_stops_at_every_badf_position(self):
+        good = [0xE0040000, 0x3FF, 1, 0x55, 0xFFFFFFFF]
+        for index in range(len(good)):
+            with self.subTest(index=index):
+                result, calls = self.run_reads(good[:index] + [0xBADF5040])
+                self.assertEqual(result["state"], "poisoned")
+                self.assertEqual(len(calls), index + 1)
+                for name, _ in REGISTERS[index + 1:]:
+                    self.assertIsNone(result["registers"][name])
+
+    def test_stops_on_booting_all_ones_and_io_error(self):
+        for values, state in [([0xFFFFFFFF], "unknown"),
+                              ([0xE0040000, 0x301], "booting"),
+                              ([0xE0040000, OSError("read failed")], "unknown")]:
+            with self.subTest(values=values):
+                result, calls = self.run_reads(values)
+                self.assertEqual(result["state"], state)
+                self.assertEqual(len(calls), len(values))
+                self.assertIsNone(result["registers"]["DSOV"])
+
+    def test_candidate_is_not_active_validation(self):
+        result, _ = self.run_reads([0xE0040000, 0x3FF, 0, 0x55, 0xFFFFFFFF])
+        self.assertEqual(result["state"], "candidate")
+        self.assertIn("active validation not performed", result["reason"])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/host/test_serial_response.py b/host/test_serial_response.py
new file mode 100644
index 0000000..f480f55
--- /dev/null
+++ b/host/test_serial_response.py
@@ -0,0 +1,38 @@
+import unittest
+
+from ga100vfi.glitch import Attempt, Card
+
+
+class FragmentedSerial:
+    def __init__(self):
+        self.parts = [b"timing i=0 scheduled=-1300 act=8 arg=32 start=-1300 end=-1264 ok=1\n",
+                      b"glitch done", b" pwd=0 e1=0xc2ea writes_failed=12", b"\n"]
+        self.sent = []
+
+    def reset_input_buffer(self):
+        pass
+
+    def write(self, data):
+        self.sent.append(data)
+
+    def flush(self):
+        pass
+
+    def read(self, _size):
+        return self.parts.pop(0)
+
+
+class SerialResponseTest(unittest.TestCase):
+    def test_completion_marker_waits_for_full_line(self):
+        card = Card.__new__(Card)
+        card.s = FragmentedSerial()
+        report = card.attempt(Attempt())
+        self.assertEqual(report.writes_failed, 12)
+        self.assertEqual(report.e1, 0xC2EA)
+        self.assertIn("timing i=0", report.raw)
+        self.assertEqual(card.s.parts, [])
+        self.assertEqual(len(card.s.sent), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
