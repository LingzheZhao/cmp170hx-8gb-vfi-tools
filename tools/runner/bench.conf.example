# shellcheck shell=bash disable=SC2034
# bench.conf: settings for bootrun.sh and cycle.sh (a bash file, sourced). Copy it to bench.conf next to the
# scripts and fill it in. bench.conf names your hosts and is listed in .gitignore: keep it out of version control.
# Settings written as ${NAME:-default} can be overridden from the environment for one run.

# The bench host: the machine with the card, the Pico and the glitch boot. Reached over ssh with a key, as root.
BENCH_SSH=root@bench.example.lan
BENCH_ADDR=                                  # what ping uses to see the host go down (default: host part of BENCH_SSH)

# Power control. wol: OS poweroff, wait until the host stops answering ping, Wake-on-LAN.
#                ipmi: OS poweroff, the BMC confirms it is off (hard power-off if a clean shutdown stalls), BMC power on.
POWER=${POWER:-wol}
WOL_MAC=                                     # the bench NIC's MAC address
WOL_BROADCAST="255.255.255.255"              # space-separated; add your subnet's broadcast address if needed
IPMI_HOST=                                   # BMC address
IPMI_USER=
IPMI_PASSFILE=                               # a 0600 file that ipmitool -f reads the BMC login from
IPMI_OPTS="-I lanplus"                       # some BMCs also need a cipher suite, e.g. "-I lanplus -C 17"
OFFWAIT=${OFFWAIT:-15}                       # seconds with the host off before power on

# On the bench host
BENCH_DIR=/opt/vfi                           # bootrun.sh copies bisect_shots.py, park.py, preflight.py,
                                             # vfi_snap.py and vfi_common.py here before every run
BENCH_PY=/opt/vfi/venv/bin/python            # a venv with the patched ga100vfi package (pip install ./host)
BENCH_TASKSET=                               # optional CPU pinning prefix, e.g. "taskset -c 2-7"
PICO_PORT=/dev/ttyACM0                       # better: the /dev/serial/by-id/usb-Raspberry_Pi_... link
GLITCH_CMDLINE=                              # optional: a word that must be on /proc/cmdline (your glitch boot entry)
MASK_PCIEHP=0                                # 1: mask pciehp interrupts on a hotplug-capable root port before the run
FRESH_MAX=900                                # refuse to run when the bench has been up longer than this, seconds

# On this machine
LOG_DIR=.                                    # bootrun-<card>.last (the run log) goes here
ON_HOLD=                                     # command run here when a goldilocks is held; empty = stop and report.
                                             # It gets CARD, TAG, BENCH_SSH, BENCH_DIR and RUN_LOG in its environment.

# One function per card: "bootrun.sh example ..." calls card_example. Read GPC and SMC from tools/vfi_snap.py on a
# cold boot of that card; the run stops when the card on the bench does not match them.
card_example() {
  TAG="card example"                         # label in the runner's log
  GPC=0x00000000                             # GPC_DISABLE as vfi_snap.py prints it: "GPC dis/def/st=<GPC>/..."
  SMC="SM now=70 ceiling=0"                  # must appear in vfi_snap.py's output as printed
  CARD_BDF=                                  # optional; empty = the only 10de:20c2 card on the bench
  PLAN_LOCAL=                                # optional: a directory of reviewed files on this machine ...
  PLAN_REMOTE=                               # ... and the bench directory whose copies must match them by sha256
  PLAN_FILES=""                              # the file names, in both directories (empty = no checksum)
}
