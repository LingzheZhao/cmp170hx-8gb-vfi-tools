From f5a85faba799cbedd78f0dfbe6b4ae141eed35a7 Mon Sep 17 00:00:00 2001
From: darkmaniac7 <31073889+darkmaniac7@users.noreply.github.com>
Date: Fri, 20 Nov 2026 01:07:20 -0600
Subject: [PATCH 5/5] host: classify stops at a 0xBADF DSOV; the EN_SW_OVERRIDE
 write is opt-in

Two changes to classify(), both run on the lab's bench:

- DSOV is checked right after FUSECTRL. If it reads 0xBADFxxxx (seen on
  one card behind a healthy FUSECTRL), nothing else is read or written:
  the verdict carries that DSOV value, privilege mask and CRC 0, the FPF
  row unreadable, and shadow["DSOV_POISONED"].

- Check 5 wrote 1 to 0x00820040 after every shot. That register is
  EN_SW_OVERRIDE, and on the bench it kept its value across PEX_RST, so
  after the first shot of a boot every later shot ran with the software
  override on. The write now happens only with classify(..., write=True)
  or CLASSIFY_WRITE=1 in the environment. Without it 0x00820040 is read
  into dsov_writeback, Verdict.dsov_written is False and check 5 is left
  out of Verdict.checks, so Verdict.passed rests on DSOV 0, a readable
  FPF row, privilege mask 0xFFFFFFFF and CRC 0x55, and campaign still
  reports goldilocks.

An A/B run on one card (four boots alternating with and without the
write, same ladder) showed no edge change: three boots, both modes, stayed
under to 356 mV and lost the link at 350 mV; the fourth, without the
write, lost the link on its second shot at 450 mV.

The docstring no longer says the next PEX_RST clears a poisoned
controller: on the cards tested it stayed poisoned until a power cycle.

Test: host/test_classify.py.
---
 host/ga100vfi/classify.py |  43 ++++++++++---
 host/test_classify.py     | 125 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 160 insertions(+), 8 deletions(-)
 create mode 100644 host/test_classify.py

diff --git a/host/ga100vfi/classify.py b/host/ga100vfi/classify.py
index 84ef87d..a83aaf7 100644
--- a/host/ga100vfi/classify.py
+++ b/host/ga100vfi/classify.py
@@ -5,6 +5,8 @@
 3. read DSOV (0x00820084); continue unless it reads 0
 4. read an FPF row (0x00824314); continue if it reads 0xffffffff
 5. write DSOV = 1 (0x00820040), read back; continue unless it reads 1
+   (0x00820040 is EN_SW_OVERRIDE and keeps its value across PEX_RST; the write
+   is opt-in, see classify())
 6. dump the shadow fuse registers and compare with the baseline (logged only)
 7. read NV_FUSE_OPT_PRIV_LEVEL_MASK (0x008200fc); Goldilocks reads 0xffffffff
    (both PLMs wide open, so the shadow option words are writable)
@@ -14,6 +16,7 @@
 """
 from __future__ import annotations
 
+import os
 from dataclasses import dataclass, field
 
 DSOV = 0x00820084
@@ -44,16 +47,22 @@ class Verdict:
     crc_status: int
     shadow: dict[str, int] = field(default_factory=dict)
     shadow_diff: dict[str, tuple[int, int]] = field(default_factory=dict)
+    # False when classify() did not write 0x00820040: dsov_writeback is then only
+    # a read of that register and check 5 is left out of `checks`.
+    dsov_written: bool = True
 
     @property
     def checks(self) -> dict[str, bool]:
-        return {
+        c = {
             "dsov_zero": self.dsov == 0,
             "fpf_readable": self.fpf_row != UNREADABLE,
             "dsov_settable": self.dsov_writeback == 1,
             "priv_mask_open": self.priv_mask == 0xFFFFFFFF,
             "crc_valid": self.crc_status == CRC_GOOD,
         }
+        if not self.dsov_written:
+            del c["dsov_settable"]
+        return c
 
     @property
     def passed(self) -> bool:
@@ -66,6 +75,7 @@ class Verdict:
             "dsov": self.dsov,
             "fpf_row": self.fpf_row,
             "dsov_writeback": self.dsov_writeback,
+            "dsov_written": self.dsov_written,
             "priv_mask": self.priv_mask,
             "crc_status": self.crc_status,
             "shadow": self.shadow,
@@ -81,18 +91,35 @@ FUSECTRL = 0x00820000
 POISON_TAG = 0xBADF0000
 
 
-def classify(bar, baseline: dict[str, int] | None = None) -> Verdict:
-    """Run checks 3-8. Leaves DSOV set to 1 if check 5 succeeds.
+def _poisoned(value: int) -> bool:
+    return (value & 0xFFFF0000) == POISON_TAG
+
+
+def classify(bar, baseline: dict[str, int] | None = None, write: bool | None = None) -> Verdict:
+    """Run checks 3-8.
 
     Read FUSECTRL first. A disturbed fuse read can leave the controller at 0xBADFxxxx; more BAR0 reads
-    on such a card are a host-hang risk.
-    Poisoned -> read nothing else, report an over-glitched shot (priv_mask 0 marks it); the next PEX_RST clears it."""
+    on such a card are a host-hang risk. Poisoned -> read nothing else, report an over-glitched shot
+    (priv_mask 0 marks it). The same holds when DSOV itself reads 0xBADFxxxx behind a healthy FUSECTRL:
+    the verdict carries that DSOV value and nothing after it is read or written. On the cards tested a
+    poisoned controller stayed poisoned until a power cycle, so later shots of the same boot read
+    poisoned too.
+
+    Check 5 writes 1 to 0x00820040 (EN_SW_OVERRIDE). That register keeps its value across PEX_RST, so
+    after one such write every later shot of the boot runs with the software override on. The write
+    happens only with write=True, or with CLASSIFY_WRITE=1 in the environment when write is None.
+    Without it 0x00820040 is only read, and check 5 is left out of Verdict.checks."""
+    if write is None:
+        write = os.environ.get("CLASSIFY_WRITE") == "1"
     ctrl = bar.rd32(FUSECTRL)
-    if (ctrl & 0xFFFF0000) == POISON_TAG:
+    if _poisoned(ctrl):
         return Verdict(0, UNREADABLE, 0, 0, 0, {"FUSECTRL_POISONED": ctrl}, {})
     dsov = bar.rd32(DSOV)
+    if _poisoned(dsov):
+        return Verdict(dsov, UNREADABLE, 0, 0, 0, {"DSOV_POISONED": dsov}, {})
     fpf = bar.rd32(FPF_ROW)
-    bar.wr32(DSOV_SET, 1)
+    if write:
+        bar.wr32(DSOV_SET, 1)
     writeback = bar.rd32(DSOV_SET)
     priv = bar.rd32(PRIV_MASK)
     crc = bar.rd32(CRC_STATUS)
@@ -100,4 +127,4 @@ def classify(bar, baseline: dict[str, int] | None = None) -> Verdict:
     diff = {}
     if baseline:
         diff = {k: (baseline.get(k), v) for k, v in shadow.items() if baseline.get(k) != v}
-    return Verdict(dsov, fpf, writeback, priv, crc, shadow, diff)
+    return Verdict(dsov, fpf, writeback, priv, crc, shadow, diff, write)
diff --git a/host/test_classify.py b/host/test_classify.py
new file mode 100644
index 0000000..05dbc3d
--- /dev/null
+++ b/host/test_classify.py
@@ -0,0 +1,125 @@
+"""Offline tests for classify(): a fake BAR0 that logs every access. Run from host/:
+python3 -m unittest test_classify"""
+import os
+import unittest
+
+from ga100vfi.classify import (CRC_STATUS, DSOV, DSOV_SET, FPF_ROW, FUSECTRL, PRIV_MASK, SHADOW,
+                               UNREADABLE, classify)
+
+HEALTHY = {FUSECTRL: 0xE0040000, DSOV: 1, FPF_ROW: 0x00000000, DSOV_SET: 0, PRIV_MASK: 0xFFFFFFFF,
+           CRC_STATUS: 0x55}
+
+
+class FakeBar:
+    def __init__(self, **over):
+        self.regs = dict(HEALTHY)
+        self.regs.update({globals()[k]: v for k, v in over.items()})
+        self.log = []
+
+    def rd32(self, off):
+        self.log.append(("rd", off))
+        return self.regs.get(off, 0)
+
+    def wr32(self, off, value):
+        self.log.append(("wr", off, value))
+        self.regs[off] = value
+
+    def writes(self):
+        return [x for x in self.log if x[0] == "wr"]
+
+    def reads(self):
+        return [x[1] for x in self.log if x[0] == "rd"]
+
+
+class ClassifyTest(unittest.TestCase):
+    def setUp(self):
+        self._env = os.environ.pop("CLASSIFY_WRITE", None)
+
+    def tearDown(self):
+        os.environ.pop("CLASSIFY_WRITE", None)
+        if self._env is not None:
+            os.environ["CLASSIFY_WRITE"] = self._env
+
+    def test_default_writes_nothing(self):
+        bar = FakeBar()
+        v = classify(bar)
+        self.assertEqual(bar.writes(), [])
+        self.assertEqual(bar.reads()[:7], [FUSECTRL, DSOV, FPF_ROW, DSOV_SET, PRIV_MASK, CRC_STATUS,
+                                           list(SHADOW.values())[0]])
+        self.assertFalse(v.dsov_written)
+        self.assertNotIn("dsov_settable", v.checks)
+        self.assertEqual(v.dsov, 1)
+        self.assertFalse(v.passed)
+
+    def test_goldilocks_without_the_write(self):
+        bar = FakeBar(DSOV=0)
+        v = classify(bar)
+        self.assertEqual(bar.writes(), [])
+        self.assertEqual(v.dsov_writeback, 0)          # EN_SW_OVERRIDE read, not set
+        self.assertTrue(v.passed, v.checks)
+
+    def test_write_opt_in_by_environment(self):
+        os.environ["CLASSIFY_WRITE"] = "1"
+        bar = FakeBar(DSOV=0)
+        v = classify(bar)
+        self.assertEqual(bar.writes(), [("wr", DSOV_SET, 1)])
+        self.assertTrue(v.dsov_written)
+        self.assertTrue(v.checks["dsov_settable"])
+        self.assertTrue(v.passed)
+        os.environ["CLASSIFY_WRITE"] = "0"
+        bar = FakeBar()
+        classify(bar)
+        self.assertEqual(bar.writes(), [])
+
+    def test_write_argument_overrides_environment(self):
+        os.environ["CLASSIFY_WRITE"] = "1"
+        bar = FakeBar()
+        classify(bar, write=False)
+        self.assertEqual(bar.writes(), [])
+        os.environ.pop("CLASSIFY_WRITE")
+        bar = FakeBar()
+        v = classify(bar, write=True)
+        self.assertEqual(bar.writes(), [("wr", DSOV_SET, 1)])
+        self.assertEqual(v.dsov_writeback, 1)
+
+    def test_write_that_does_not_stick_fails_check_5(self):
+        class Stuck(FakeBar):
+            def wr32(self, off, value):
+                self.log.append(("wr", off, value))
+        bar = Stuck(DSOV=0)
+        v = classify(bar, write=True)
+        self.assertFalse(v.checks["dsov_settable"])
+        self.assertFalse(v.passed)
+
+    def test_poisoned_fusectrl_reads_nothing_else(self):
+        os.environ["CLASSIFY_WRITE"] = "1"
+        bar = FakeBar(FUSECTRL=0xBADF5040)
+        v = classify(bar)
+        self.assertEqual(bar.log, [("rd", FUSECTRL)])
+        self.assertEqual((v.dsov, v.priv_mask, v.crc_status, v.fpf_row), (0, 0, 0, UNREADABLE))
+        self.assertEqual(v.shadow, {"FUSECTRL_POISONED": 0xBADF5040})
+        self.assertFalse(v.passed)
+
+    def test_poisoned_dsov_stops_before_any_write(self):
+        os.environ["CLASSIFY_WRITE"] = "1"
+        bar = FakeBar(DSOV=0xBADF1701)
+        v = classify(bar)
+        self.assertEqual(bar.log, [("rd", FUSECTRL), ("rd", DSOV)])
+        self.assertEqual(v.dsov, 0xBADF1701)
+        self.assertEqual((v.priv_mask, v.crc_status, v.fpf_row), (0, 0, UNREADABLE))
+        self.assertEqual(v.shadow, {"DSOV_POISONED": 0xBADF1701})
+        self.assertFalse(v.passed)
+
+    def test_other_bad_dsov_values_are_not_goldilocks(self):
+        for dsov in (2, 0xFFFFFFFF, 0xBAD00100):
+            with self.subTest(dsov=hex(dsov)):
+                v = classify(FakeBar(DSOV=dsov))
+                self.assertFalse(v.passed)
+
+    def test_as_dict_reports_the_write_mode(self):
+        self.assertFalse(classify(FakeBar()).as_dict()["dsov_written"])
+        self.assertTrue(classify(FakeBar(), write=True).as_dict()["dsov_written"])
+
+
+if __name__ == "__main__":
+    unittest.main()
